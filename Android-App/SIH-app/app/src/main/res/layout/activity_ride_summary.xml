<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:letterSpacing="0.1"
        android:text="OVERALL RIDE SCORE"
        android:textColor="#777777"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Giant Dynamic Score -->
    <TextView
        android:id="@+id/txtFinalScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="100"
        android:textColor="#00FF66"
        android:textSize="110sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="#222222" />

    <!-- Analytics Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.05"
        android:text="PERFORMANCE INSIGHTS"
        android:textColor="#777777"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Dynamic Feedback Container -->
    <TextView
        android:id="@+id/txtFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#111111"
        android:lineSpacingExtra="6dp"
        android:padding="20dp"
        android:text="🌟 Excellent ride! Perfect transmission efficiency and smooth cornering."
        android:textColor="#DDDDDD"
        android:textSize="18sp" />

    <!-- Spacer to push button to the bottom -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Return Button -->
    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#3399FF"
        android:text="FINISH RIDE"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>